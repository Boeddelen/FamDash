# Copy to .env and adjust. All values are optional — sensible defaults are used.

# TCP port the dashboard listens on. Change this if it collides with something else
# already running on the Mac.
PORT=4174

# Where the database, encryption key, uploads, logs and backups live.
# Back up the dashboard by copying this directory.
DATA_DIR=./data

# Override the SQLite file location (defaults to $DATA_DIR/dashboard.db).
#DB_PATH=./data/dashboard.db

# 32-byte base64 key used to encrypt calendar credentials at rest.
# Leave unset to auto-generate one into $DATA_DIR/secret.key on first run.
# Generate manually with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#SECRET_KEY=

# Minutes an admin session survives without activity before dropping to standard mode.
ADMIN_IDLE_TIMEOUT_MIN=5

# Bind address for the Node server (adapter-node). 0.0.0.0 exposes it on the LAN.
HOST=0.0.0.0

# Max upload size — school-term PDFs can be a few MB, so keep this generous.
BODY_SIZE_LIMIT=16M

# Trust the X-Forwarded-* headers (set to 1 if running behind a reverse proxy / TLS).
#PROTOCOL_HEADER=x-forwarded-proto
#HOST_HEADER=x-forwarded-host
